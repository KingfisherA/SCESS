# Alternative GNU Make workspace makefile autogenerated by Premake

ifndef config
  config=debug
endif

ifndef verbose
  SILENT = @
endif

ifeq ($(config),debug)
  QuantumSCESS_config = debug
  SCESS_config = debug
  ViewerSCESS_config = debug

else ifeq ($(config),release)
  QuantumSCESS_config = release
  SCESS_config = release
  ViewerSCESS_config = release

else
  $(error "invalid configuration $(config)")
endif

PROJECTS := QuantumSCESS SCESS ViewerSCESS

.PHONY: all clean help $(PROJECTS) 

all: $(PROJECTS)

QuantumSCESS:
ifneq (,$(QuantumSCESS_config))
	@echo "==== Building QuantumSCESS ($(QuantumSCESS_config)) ===="
	@${MAKE} --no-print-directory -C Projects/gmake2 -f QuantumSCESS.make config=$(QuantumSCESS_config)
endif

SCESS: QuantumSCESS
ifneq (,$(SCESS_config))
	@echo "==== Building SCESS ($(SCESS_config)) ===="
	@${MAKE} --no-print-directory -C Projects/gmake2 -f SCESS.make config=$(SCESS_config)
endif

ViewerSCESS: QuantumSCESS
ifneq (,$(ViewerSCESS_config))
	@echo "==== Building ViewerSCESS ($(ViewerSCESS_config)) ===="
	@${MAKE} --no-print-directory -C Projects/gmake2 -f ViewerSCESS.make config=$(ViewerSCESS_config)
endif

clean:
	@${MAKE} --no-print-directory -C Projects/gmake2 -f QuantumSCESS.make clean
	@${MAKE} --no-print-directory -C Projects/gmake2 -f SCESS.make clean
	@${MAKE} --no-print-directory -C Projects/gmake2 -f ViewerSCESS.make clean

help:
	@echo "Usage: make [config=name] [target]"
	@echo ""
	@echo "CONFIGURATIONS:"
	@echo "  debug"
	@echo "  release"
	@echo ""
	@echo "TARGETS:"
	@echo "   all (default)"
	@echo "   clean"
	@echo "   QuantumSCESS"
	@echo "   SCESS"
	@echo "   ViewerSCESS"
	@echo ""
	@echo "For more information, see https://github.com/premake/premake-core/wiki"